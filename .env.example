# URL del API de Strapi.
# Para desarrollar contra el Strapi de producción:
#   NUXT_PUBLIC_API_BASE=https://mandaditoz-back-production.up.railway.app/api
NUXT_PUBLIC_API_BASE=http://localhost:1337/api

NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Microsoft Clarity. Vacío = sin analítica.
NUXT_PUBLIC_CLARITY_ID=

# Botón "Continuar con Google". Es el client ID de tipo "Aplicación web" de
# Google Cloud Console — el MISMO que `GOOGLE_CLIENT_IDS` en el backend, y el
# mismo que usa la app Android (pide su token con el client id web).
# Es un valor público: aparece en el HTML. El secret NO se usa aquí.
# Vacío = no se pinta el botón y solo queda el alta por correo.
#
# `npm run build:mobile` no lo repite en su línea de comandos a propósito: Nuxt
# carga este .env antes de evaluar nuxt.config, así que de aquí sale también el
# valor que se compila dentro del APK.
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
